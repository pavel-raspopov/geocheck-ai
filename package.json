{
  "name": "geo-check-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "qa": "pnpm build && node scripts/qa/ui-shell.mjs",
    "qa:testdata": "pnpm build && node scripts/qa/testdata.mjs",
    "qa:all": "pnpm build && node scripts/qa/ui-shell.mjs && node scripts/qa/testdata.mjs",
    "shot": "pnpm build && node scripts/qa/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
